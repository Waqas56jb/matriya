# =============================================================================
# MATRIYA-BACK — COPY TO `.env` AND FILL. Never commit `.env` (gitignored).
# If this file was pasted in chat/email, rotate Postgres, JWT, API keys, Twilio.
# =============================================================================

# --- DATABASE (one working connection required) -----------------------------
# Supabase pooler (port 6543) is preferred for app + serverless.
POSTGRES_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres
# POSTGRES_PRISMA_URL=
# SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- SUPABASE REST (Twilio pipeline, webhooks, bucket features) ------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Service role or server secret — never expose in browser.
SUPABASE_KEY=YOUR_SUPABASE_SERVICE_OR_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=

# --- AUTH (stable JWT across deploys) ---------------------------------------
JWT_SECRET=CHANGE_ME_32_PLUS_RANDOM_BYTES

# Same value on admin-backend — provisioning management users (X-Matriya-Provision-Key header)
MATRIYA_PROVISION_SECRET=CHANGE_ME_MATCH_ADMIN_BACKEND

# Same value on admin-backend — POST /api/internal/whatsapp-outbound
MATRIYA_INTERNAL_KEY=CHANGE_ME_MATCH_ADMIN_BACKEND

# Optional: block POST /auth/signup on this API
# MATRIYA_DISABLE_PUBLIC_SIGNUP=1

# Production (NODE_ENV=production): SPA from ./public is OFF by default at / → JSON API root (clearer Railway deploy).
# Set to 1 to bundle-serve CRA from matriya-back/public alongside the API (legacy combo).
# MATRIYA_SERVE_EMBEDDED_SPA=0

# --- SERVER -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
NODE_ENV=development
# LOG_LEVEL=INFO
# Railway/container hosts set PORT automatically; config prefers PORT over API_PORT when both exist.
EXPRESS_BODY_LIMIT=15mb

# --- UPLOAD / RAG STORAGE ---------------------------------------------------
MAX_FILE_SIZE=52428800
COLLECTION_NAME=rag_documents
CHUNK_SIZE=500
CHUNK_OVERLAP=100
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# UPLOAD_DIR=./uploads
# CHROMA_DB_PATH=./chroma_db

# --- OPENAI (primary RAG path) ----------------------------------------------
OPENAI_API_KEY=sk-your-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_RAG_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
# USE_OPENAI_FILE_SEARCH=true
# MATRIYA_OPENAI_VECTOR_STORE_ID=vs_...
# MATRIYA_OPENAI_AUTO_SYNC_DEBOUNCE_MS=2000
# MATRIYA_OPENAI_SYNC_WAIT_FOR_INDEXING=1
# MATRIYA_GPT_RAG_BATCH_POLL_MAX=120

# --- FALLBACK LLMs (if not using OpenAI-only) --------------------------------
# TOGETHER_API_KEY=
# TOGETHER_MODEL=mistralai/Mistral-7B-Instruct-v0.2
# HF_API_TOKEN=
# HF_MODEL=microsoft/phi-2
MATRIYA_LLM_TEMPERATURE=0

# --- MANAGEMENT BACKEND (API URLs only — not SPA URLs) -----------------------
# Example production (replace with your Railway/Vercel API host for managment-back):
MANAGEMENT_BACK_URL=https://your-managment-backend.example.com
MATRIYA_MANAGEMENT_API_URL=https://your-managment-backend.example.com
# MATRIYA_MANAGEMENT_BACK_URL=
# Must match MANEGER_MATERIALS_SUMMARY_SERVER_KEY on managment-back
MATRIYA_MANAGEMENT_MATERIALS_KEY=shared_secret_matches_matriya_back

# SPA URLs belong in matriya-front / managment-front `.env`, not here:
# - https://matriya-frontend.vercel.app
# - https://matriya-management.vercel.app
# - https://matriya-admin.vercel.app
# - https://matriya-system-project.vercel.app  (finance UI)

# --- FINANCE MICROSERVICE ----------------------------------------------------
FINANCE_API_URL=https://your-matriya-finance-backend.example.com

# --- TWILIO / WHATSAPP --------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+972XXXXXXXXX
TWILIO_WHATSAPP_NUMBER=+972XXXXXXXXX
TWILIO_WHATSAPP_REPLY=1
# Twilio/configure webhooks — this app exposes:
#   POST /api/webhook/whatsapp   and   POST /api/whatsapp/inbound
TWILIO_WEBHOOK_PUBLIC_URL=https://your-matriya-api.example.com/api/webhook/whatsapp
# TWILIO_WEBHOOK_WHATSAPP_URL=
# SKIP_TWILIO_SIG_CHECK=1
DAVID_WHATSAPP=whatsapp:+972XXXXXXXXX
RACHEL_WHATSAPP=whatsapp:+972XXXXXXXXX
WHATSAPP_WHITELIST_ENABLED=1
# WHATSAPP_ALLOWED_FROM=
# TWILIO_REPLY_TEXT_TEMPLATE=

# --- ANSWER COMPOSER / LAB BRIDGE ---------------------------------------------
# ANSWER_COMPOSER_SKIP_EXTERNAL=1
# LAB_VISCOSITY_THRESHOLD_PCT=10
# MATRIYA_INTERNAL_BASE_URL=
# MATRIYA_BASE_URL=

# --- B-INTEGRITY RULES -------------------------------------------------------
# B_INTEGRITY_MAX_GROWTH_RATIO=0.5
# B_INTEGRITY_NO_PROGRESS_CYCLES=3
# B_INTEGRITY_METRIC_CAP=0
# B_INTEGRITY_MAX_DROP_PERCENT=100

# --- KERNEL V1.6 -------------------------------------------------------------
# KERNEL_V16_STRICT=1
# KERNEL_V16_ANCHOR_REQUIRED=1

# --- RESEARCH GATE / DOMAIN / GENERATION ------------------------------------
# MATRIYA_PRE_LLM_MIN_SIMILARITY=0.75
# MATRIYA_PRE_LLM_MIN_CHUNKS=2
# MATRIYA_RETRIEVAL_SIMILARITY_THRESHOLD=0.7
# MATRIYA_MAX_ATTRIBUTION_SOURCES=3
# MATRIYA_DOMAIN_MIN_QUERY_OVERLAP=2
# MATRIYA_GENERATION_MIN_CHUNKS=1
# MATRIYA_GENERATION_MIN_TOPK_SIMILARITY_SUM=
# MATRIYA_GENERATION_TOPK_SUM_K=3

# --- OPENAI / SNIPPETS / TESTING ----------------------------------------------
# MATRIYA_ASK_MAX_GATE_CHUNKS=16
# MATRIYA_SOURCE_PREVIEW_CHARS=
# MATRIYA_SNIPPET_INDEX_FILTER=
# MATRIYA_GAP_EXPECTED_RATIOS=

# --- EXTERNAL LAYER -----------------------------------------------------------
# EXTERNAL_LAYER_POSTGRES_URL=

# --- OTHER -------------------------------------------------------------------
# GITHUB_WEBHOOK_SECRET=
PYTHON_CMD=python3
# FINANCE_SHADOW_SIGNALS_PATH=

# --- CLI / STAGING SMOKE (optional; not read by production server startup) -----
# MATRIYA_API_BASE=https://your-matriya-api.example.com
# API_BASE_URL=
# STAGING_RESEARCH_SESSION_ID=
# STAGING_DECISION_QUERY=
# STAGING_DECISION_PROJECT_ID=staging-proof

# -----------------------------------------------------------------------------
# SCHEMA: Run once in Supabase SQL Editor before /decision/run audit proofs:
#   matriya-back/migrations/decision_run_v110_audit.sql

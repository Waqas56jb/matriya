# Admin Backend — Environment Variables
# Copy to .env and fill in real values

PORT=9000
NODE_ENV=production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT — use a long random string, different from matriya-back JWT_SECRET
ADMIN_JWT_SECRET=your_admin_jwt_secret_min_32_chars

# One-time seed secret to create first admin account via /api/admin/auth/create-admin
# Remove or leave blank after first admin is created
ADMIN_SEED_SECRET=your_one_time_seed_secret

# CORS — URL of the admin frontend
ADMIN_FRONTEND_URL=https://your-admin-frontend.vercel.app

# Other service URLs
MATRIYA_BACK_URL=https://matriya-system-project-production.up.railway.app
MANAGEMENT_BACK_URL=https://steadfast-success-production-02d1.up.railway.app
MATRIYA_FINANCE_URL=https://your-finance-service.up.railway.app

# Twilio (for WhatsApp resend from admin panel)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+972539647624

PORT=3100
PYTHON_CMD=python3

# Supabase — same project as matriya-back (signals stored in finance_signals table)
# Run matriya-back/sql/finance_signals.sql once in Supabase SQL Editor first.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Twilio — copy same values from matriya-back Railway env vars
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_WHATSAPP_NUMBER=+14155238886   # alternative to FROM
TWILIO_WHATSAPP_TO=whatsapp:+972xxxxxxxxx
# DAVID_WHATSAPP=whatsapp:+972xxxxxxxxx  # used if TWILIO_WHATSAPP_TO unset
# RACHEL_WHATSAPP=whatsapp:+972xxxxxxxxx

# FRED — free API key from https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# SEC EDGAR — describe your app + contact email (SEC policy)
SEC_EDGAR_USER_AGENT=MATRIYA-Finance your@email.com

# CORS — comma-separated Vercel origins for finance dashboard (or * for dev)
FINANCE_CORS_ORIGINS=https://your-finance-dashboard.vercel.app
